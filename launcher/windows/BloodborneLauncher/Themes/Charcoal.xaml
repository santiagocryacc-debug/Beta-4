<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bloodborne palette: soot, dark walnut, aged brass and restrained blood red. -->
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF17110F" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#FF211713" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2B1E18" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF261A15" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF493329" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF493329" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF30221B" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF3A2920" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF281C17" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1B120F" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF594033" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF463127" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF281C17" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF30211A" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF241914" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF1D1411" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF19110E" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF211713" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF261A15" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#FF1D1411" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF1D1411" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF261A15" />

    <!-- Dense text surfaces -->
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#FF1A120F" />

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#CC080504" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF2A1D17" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#FF634631" />

    <!-- Navigation -->
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#FF572621" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#FF39271F" />
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#FFB59A72" />

    <!-- Text and accents -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2E7D5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFD0BFA8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9B8975" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD8B46A" />
    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#FF847264" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFE2B75F" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFE26B61" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#FFA7C58C" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF762F29" />

    <!-- Pane, divider and pill colours -->
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#FF2B1E18" />
    <SolidColorBrush x:Key="GlassPaneStrokeBrush" Color="#FF493329" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#FF493329" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#FF1B120F" />

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

</ResourceDictionary>
