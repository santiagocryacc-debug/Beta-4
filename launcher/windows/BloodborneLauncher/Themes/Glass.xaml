<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm, opaque-feeling surfaces; keep the game's artwork subtle, not glossy. -->
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#E6221712" />
    <LinearGradientBrush x:Key="GlassPaneStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#668D6A43" Offset="0" />
        <GradientStop Color="#334D3325" Offset="0.35" />
        <GradientStop Color="#224D3325" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#334D3325" />

    <!-- The selected tab uses blood red; the surrounding track stays walnut-dark. -->
    <SolidColorBrush x:Key="PillTrackBrush" Color="#AA120B08" />
    <LinearGradientBrush x:Key="SegmentSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF84372D" Offset="0" />
        <GradientStop Color="#FF5B211D" Offset="1" />
    </LinearGradientBrush>

    <!-- WPF-UI surfaces -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E62B1E18" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#D9211712" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#805D4130" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#D932231B" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E63B2920" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#CC281B15" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#EE160E0A" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#995D4130" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#664D3528" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#553D291F" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#443E2A20" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="Transparent" />
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF17110F" />
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#CC120B08" />

    <!-- Opaque, warm dialogs for readable prompts. -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#D9080503" />
    <LinearGradientBrush x:Key="DialogBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF302119" Offset="0" />
        <GradientStop Color="#FF211611" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DialogStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#806E4A31" Offset="0" />
        <GradientStop Color="#333B261B" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2E7D5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFD0BFA8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9B8975" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD8B46A" />

</ResourceDictionary>
